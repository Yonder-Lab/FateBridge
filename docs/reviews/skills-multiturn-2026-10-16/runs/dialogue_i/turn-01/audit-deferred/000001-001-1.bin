主推角色","household_scope是工程查询范围：纯符号参考不绑定现场方区，不是新增传统断法；家庭/生肖宫位索引独立于八宅命卦","妻随夫排行必须显式确认；同一人可保留父母和排行两个身份","家庭角色为主要象征对应，生肖为独立确认的另一象征索引；各自主宫优先，对宫仅次级关注","实地方位、户型对齐和立极均确认后才把象征宫位绑定实际方区","多层按统一方向逐层审查，各层立极和户型对齐独立确认，不继承全宅或其他层中心；院落归第一层；局限本层且异层适宜的条件不外推为全宅抵消","使用人名单只有正向事实；给异层豁免或共享范围外判定前，影响层的室内与院落空间须分别确认使用范围完整及依据，不能由省略名单推不使用","现代开放式厨房和拱门只作低优先提示，不要求因此拆改"],"sources":[{"source_id":"EXPERT20261015","title":"用户提供的专家访谈整理：风水方法、家庭角色与多层住宅（2026-10-15）","url":"","kind":"user_supplied_expert_policy","scope":"本次产品采用的专家口径；专家姓名与原始访谈未提供，不冒称所有流派共识，也不证明现实效力","source_version":"当前聊天用户九条意见，2026-10-15"},{"source_id":"SHUOGUA","title":"《周易·说卦》：八卦与父母、长中少子女","url":"https://ctext.org/book-of-changes/shuo-gua","kind":"classical_text","scope":"乾父、坤母及震坎艮男、巽离兑女的象征；不作为配偶随序、实际户主或现实影响的证明"},{"source_id":"SHEN_BRANCHES","title":"《沈氏玄空学》卷四：九宫挨星掌诀","url":"https://www.diancangwang.cn/xuanxuewushu/f6f37803664b/90b563d9cb41.html","kind":"classical_text_transcription","scope":"九宫与二十四山地支位置的固定对应；不是命盘喜忌或人物受影响结论"},{"source_id":"DPM_ZODIAC","title":"故宫博物院：十二生肖","url":"https://www.dpm.org.cn/lemmas/245505.html","kind":"museum_reference","scope":"十二地支与生肖对应；与掌诀地支位置合成的符号索引，不是命盘匹配"}],"bundle_version":"1.0.0"},"separation_policy":{"environmental_chart_inputs":"objective_environment_only","bazi_ziwei_favourable_elements":"excluded","other_people_natal_attributes":"excluded","bazhai_personal_matching":"independent_minggua_layer","selected_environmental_methods":[],"rule_id":"expert_environment_2026_10_v1.chart_separation","source_ids":["EXPERT20261015"]},"orientation_review":{"status":"not_confirmed","north_reference":null,"physical_sector_binding_allowed":false,"unknown_direction_policy":"confirmed_non_directional_facts_only","missing_inputs":[],"rule_id":"expert_environment_2026_10_v1.confirmed_sectors","source_ids":["EXPERT20261015"]},"household_correspondences":[],"floor_review":{"floors":[],"influences":[],"overall_review":"not_requested"},"environment_findings":[],"missing_inputs":[],"rule_coverage_counts":{"supported":0,"confirme