            }
          ]
        },
        {
          "intent": "独立室内形态",
          "evidence": [
            {
              "role": "primary",
              "alternatives": [
                "fengshui_assess"
              ],
              "condition": "form_observations，methods=[]"
            }
          ]
        },
        {
          "intent": "书桌工作／学习玄空用途、入口隔挡、材料施用条件",
          "evidence": [
            {
              "role": "primary",
              "alternatives": [
                "fengshui_assess"
              ],
              "condition": "显式工位作者版本；用途按落宫取向星，物件资格不推摆位"
            }
          ]
        },
        {
          "intent": "桌面物件风水摆法",
          "evidence": [
            {
              "role": "primary",
              "alternatives": [
                "fengshui_assess"
