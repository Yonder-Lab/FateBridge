  "rulesets": {
    "houtian_directions_v1": {
      "version": "1.0.0",
      "method": "directions",
      "source_ids": [
        "S4"
      ],
      "scope": "后天八卦、固定洛书宫数、八方角区与24山索引；0°北顺时针、左闭右开",
      "conventions": [
        "北方中心0°；八方半宽22.5°；24山半宽7.5°",
        "磁北和真北原样保留，禁止静默转换",
        "确认角区不是九等分户型；不自动立极"
      ]
    },
    "bazhai_sitting_v1": {
      "version": "1.0.0",
      "method": "bazhai",
      "source_ids": [
        "S1",
        "S2",
        "S3",
        "S4"
      ],
      "scope": "坐山起伏位；1864现代三元命卦锚点；8x8大游年；男女原始五数分别寄坤/艮",
      "conventions": [
        "出生时刻默认立春换年，可明确选择公历元旦；有效生年可显式覆盖",
        "命卦与宅卦独立；未知起算法返回男女候选",
        "普通位置偏吉；灶座偏凶、确认火门偏吉；床头/书桌朝向属本版本明确的应用约定，不声称原典统一标准"
      ]
    },
    "jinsuo_basic_fixed_v1": {
      "version": "1.0.0",
      "method": "jinsuo",
      "source_ids": [
        "S5"
      ],
      "scope": "八宫基础偏好：1234砂、6789水；逐个已确认特征比较",
      "conventions": [
        "不由道路/镜子/高楼等名称自动归类",
        "mixed/unknown保持无法判定；缺水不能推断有砂",
        "不含形态距离组合、24山、元运、疾病死亡财富断语"
      ]
    },
    "annual_zibai_lichun_v1": {
      "version": "1.0.0",
      "method": "annual_stars",
      "source_ids": [
        "S4",
        "S6",
        "S7",
        "S8"
      ],
      "scope": "年度紫白入中与顺飞九宫；立春到下个立春；当前20年元运单独列示",
      "conventions": [
        "年际入中递减；同年九宫顺飞",
        "固定宫数与临宫星数独立；不使用八宅星的五行表",
        "年盘不是运盘或山向宅盘；不据年星直接断整个房间吉凶"
      ]
    }
  },
