    "afsi_element_balance_v1": {
      "version": "1.0.0",
      "method": "element_adjustment",
      "source_ids": [
        "E1",
        "E3"
      ],
      "scope": "明确目标下的生/泄元素与代表物；目标从选定计算事实绑定，不由命卦推导喜用神或缺元素",
      "conventions": [
        "实际元素与色彩替代分别列示；不规定数量、重量、距离或效果概率",
        "目标方法、宅/人、位置/朝向、玄空角色各自绑定；候选盘不形成确认处方",
        "不以灶座凶方用途推导削弱游年星；未有对应来源时标明不支持",
        "E3反对摆件化解，与E1的教学路线分列，不宣称全门派一致"
      ]
    },
