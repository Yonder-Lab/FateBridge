  "call_guidance": {
    "fengshui_assess": {
      "surface_frame": "以坐着使用的桌沿为近沿near，远离坐者的桌沿为far；这是桌面坐标，不是房间前后或罗盘方向",
      "zone_legend": {
        "near_left": "左前/靠身体左",
        "near_center": "近中/靠身体中",
        "near_right": "右前/靠身体右",
        "middle_left": "左中",
        "middle_center": "中心",
        "middle_right": "右中",
        "far_left": "左后/远沿左",
        "far_center": "远中/远沿中",
        "far_right": "右后/远沿右"
      },
      "item_fields": "object_id,label,representation,observation_basis,evidence必填；zone与zone_observation_basis成对可选，属性确认与位置确认分别保存；只确认左右不能补近远，照片位置为image_observed",
      "feasibility": "feasible_zones只含用户逐区明确确认能容纳对象并保持视野的区域，不从照片空白、物件属性确认或允许移动扩展；其余省略",
      "birth_choice": "birth_date、birth_at、effective_birth_year最多传一个，不能同时传日期和时刻",
      "scene_selection": "工位scene=workstation，合租scene=shared_rental，家居scene=home；自动按事实展开飞星、金锁、八宅，局部前两法优先，显式methods优先。不为优先级补年份或宅运；年盘不替代历史宅盘。独立形态/桌面/context不要求生辰或罗盘。无场景无作者无context保留原三法默认。场景首轮fields按需追加method_policy；细节参考按需读method_details。 method_policy.priority_review_status/missing与已选计算状态独立；available_engine_layers仅现状已完整计算层，候选读priority_review_by_scope.candidates及available_candidate_engine_layers，不以候选代替现状。priority_missing_inputs为可选审查索引，不是待传参数或必追问清单。",
      "layout_planning": "家具动作放layout_constraints；候选放layout_alternatives，声明changes并独立提供新位置placement/form_observation，许可和physically_feasible各自确认。候选fields追加layout_analysis.alternatives_analysis；ready表示可执行门槛，不表示各方法均有利或现实效力。 候选features仅提供同一候选对象在新位置独立确认的金锁砂水方向/分类/依据；与新placement落宫一致。旧对象已有features而候选缺少新features时保持待确认，其他固定环境可保留。读取候选environment_adjustments及rule_comparisons，不复用旧目标砂水。 候选environmental_context不得改变非目标固定对象的楼层/坐标系；省略固定砂水仍保留原floor元数据。逐规则比较包含所选飞星原始参考，comparison_scope不表示完整组合吉凶；layer_statuses列候选真实计算状态。 镜等环境物件可仅给候选environmental_context的相关双对象interior_relations，不伪造门床桌灶placement。原关系任一端移动都重核同kind及两端，静态端已知楼层保留；改变空间归属必须changes含location。材质/器形/颜色/存活状态及代表物用途不能借搬转改写，照片或未知可独立确认。",
      "natal_interpretation": "玄空有限解释需 xuankong.interpretation 显式启用 xuankong_conditioned_v1；当前评价运 current_period_number 与 period_evidence 成对，不改历史宅运。external_forms 按全宅中心八宫独立确认外部山形/水形，未知省略，照片保留候选，不复用金锁砂水或室内靠背；床/门取用结合顶层 placements.location_direction，桌/灶未覆盖。fields 追加 layout_analysis.natal_interpretation；仅有限五行与当令形势条件，不是完整81组合吉凶或可立即搬动建议。",
      "environmental_context": "environmental_context提供独立环境/家庭/楼层事实，不传八字紫微喜忌；首轮fields追加layout_analysis.environmental_context。orientation分别确认direction_confirmed、north_reference、floorplan_alignment_confirmed、center_confirmed；未确认落宫不能同时传位置/砂水/外局分宫，仍可原始盘与独立形态。household_members按辈分/本家庭排行，household_composition_confirmed确认成员范围，配偶排行须显式声明。objects定义厨卫/绿化/器物而不改名为门床桌灶；floors保存实际使用人/对象，院落level=1，floor_influences区分本层与共同作用；异层适宜须成对依据。无注册规则的厨卫/材质器形保持未覆盖，拱门/开放厨房仅低优先提醒。 household_scope=symbolic_reference仅解释卦名/对宫，不追罗盘、不绑定实地方区；此选择不免除同时请求的楼层方位要求。家庭索引仅飞星/金锁适用，非八宅命卦。subject_ids仅正向使用事实；负向排除需有关楼层/院落usage_confirmed=true并配usage_evidence，且名单覆盖其对象显式使用人。",
      "interior_relations": "明确非罗盘关系用environmental_context.interior_relations：relation_id/source_object_id/target_object_id/kind/present/observation_basis/evidence；present必须显式true、false或null，照片true/false均候选，不由相邻/可见推直接相对。objects.role独立确认主门、厕门、镜、梁管、厕墙、尖角源，床桌灶可继承明确purpose；床柱角仅pillar_corner，不外推普通家具角。仅相关输入时fields追加layout_analysis.interior_analysis。Joey/CYFS/WOFS各作者版本独立，镜照床保留BTB异议；各动作绑定实际对象与操作权限，允许仍须新位置和物理可行确认，不作现实健康财富预测。",
      "material_facts": "材料器形用environmental_context.material_facts：fact_id/object_id/material?/shape?/colour?/plant_alive?/observation_basis/evidence；至少一属性，未知用unknown，属性按独立证据粒度保存。element_use只明确询问wood_remedy等代表物资格，不是个人喜用或房屋所需元素。AFSI材料/颜色与FSI器形参考分开；processed_wood不作AFSI木材料，明确绿色可另列颜色替代；镜面/尖角还核实际几何。仅相关输入时fields追加layout_analysis.material_analysis；资格不认证摆位或可执行动作。",
      "method_reference": "纯方法/职业家具参考可用scene=home作通用家居参考查询标签，analyze_layout=false，按问题显式methods并投影method_details；年度对照仅加实际effective_year或确认的query_at。无真实环境事实时省略environmental_context，不提交空对象或仅household_scope。scene不生成房屋/房间/观察/摆位结论；household_scope=symbolic_reference只用于已给household_members的家庭象意，不等于通用reference_only。",
      "workstation_review": "工位工作/学习用途用 environmental_context.workstation_review.activities，逐项显式选 workstation_activity_authored_v1 并给实际活动/证据；按 placements.location_direction 读取各候选宅盘向星，位置与朝向分开，不要求外部有水或桌上放水。评价运可用该review.evaluation_period独立确认，不以日期/宅运代替。入口隔挡用 entry_barriers 显式 afsi_entry_barrier_v1，分别登记实际入口/桌/隔挡、两端直线与隔挡介入观察及 operation；执行许可和通行/视野/操作/容纳独立。fields追加layout_analysis.workstation_analysis，rulesets/rule_trace保留。WOFS桌面只作reference_only，不开启固定吉位。",
      "material_application": "material_facts.application显式选afsi_application_conditions_v1；有明确element_use才核相应水体清洁/流动、金属暴露/定性尺度或植物健康，各条件用value/observation_basis/evidence独立证据。target_request_id可引用本轮element_adjustments.request_id，只有实际算出的introduced_element才可绑定；资格、条件、目标绑定、实际位置、剂量和效力分开，不因条件确认返回ready。摆位候选须重核已有application的条件和目标，不能换目标或漏旧属性。"
    },
    "western_timing_analysis": {
      "target_clock": "analysis_hour/minute 是目标钟时，按 birth_timezone；显式0有效。省略分别沿用出生小时/分钟，仅兼容日期级调用。return_timezone转换同一时刻。",
