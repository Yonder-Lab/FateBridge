# FateBridge runtime configuration
# Copy this file to .env and adjust values for your environment.

# REST API bind address and port
API_HOST=0.0.0.0
API_PORT=8010

# Comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000

# Application log level
LOG_LEVEL=INFO

# Optional API key auth for REST endpoints.
# Format: name:key,name2:key2
FATEBRIDGE_API_KEYS=
API_KEY_HEADER_NAME=X-API-Key

# Optional stdio MCP tool families, e.g. bazi,astro,knowledge.
# Empty/unset keeps the complete tool set; invalid family names fail startup.
FATEBRIDGE_MCP_FAMILIES=
# Optional scenario IDs (CSV); intersects family selection.
FATEBRIDGE_MCP_SCENARIOS=
